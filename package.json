{
  "name": "globalli-notifications",
  "version": "1.0.0",
  "description": "Real-time notification system for an online gaming platform (Globalli coding challenge)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node dist/demo.js",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
