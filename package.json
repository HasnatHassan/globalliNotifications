{
  "name": "globalli-notifications",
  "version": "1.0.0",
  "description": "Real-time notification system for an online gaming platform (Globalli coding challenge)",
  "author": "Hasnat Hassan <hasnathassan78@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HasnatHassan/globalliNotifications.git"
  },
  "homepage": "https://github.com/HasnatHassan/globalliNotifications#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predemo": "npm run build",
    "demo": "node dist/demo.js",
    "prestart": "npm run build",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts"
  },
  "dependencies": {
    "express": "4.22.3",
    "ws": "8.22.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
